#!/bin/sh
# ImmortalWrt / LibWrt x86 主路由：PPPoE 自动 DHCPv6-PD，LAN 使用 SLAAC。
# 不更改 WAN 协议、拨号账号密码、IPv4 地址或防火墙。

[ "$(uci -q get network.wan)" = interface ] || exit 1
[ "$(uci -q get network.lan)" = interface ] || exit 1
[ "$(uci -q get dhcp.lan)" = dhcp ] || exit 1
[ "$(uci -q get 'dhcp.@dnsmasq[0]')" = dnsmasq ] || exit 1

# PPPoE 在拨号后自动建立 wan_6，申请 IPv6 地址及 PD 前缀。
uci set network.wan.ipv6='auto' || exit 1
uci set network.wan.delegate='1' || exit 1
uci -q delete network.wan.ip6assign || true
uci set network.lan.delegate='0' || exit 1
uci set network.lan.ip6assign='64' || exit 1
uci set network.lan.ip6ifaceid='eui64' || exit 1

# 默认独立 wan6 如绑定 WAN 物理口，会与 PPP 自动生成的 wan_6 并存。
# 仅停用绑定同一物理口的默认 DHCPv6 接口，保留自定义 WAN6 配置。
wan_device=$(uci -q get network.wan.device || uci -q get network.wan.ifname || true)
wan6_device=$(uci -q get network.wan6.device || uci -q get network.wan6.ifname || true)
wan6_proto=$(uci -q get network.wan6.proto || true)
if [ -n "$wan_device" ] && [ "$wan_device" = "$wan6_device" ] && [ "$wan6_proto" = 'dhcpv6' ]; then
    uci set network.wan6.auto='0' || exit 1
fi

# LAN RA/SLAAC；不通过 RA 通告 IPv6 DNS，并按用户需要过滤 AAAA 记录。
uci set 'dhcp.@dnsmasq[0].filter_aaaa=1' || exit 1
uci set dhcp.lan.ra='server' || exit 1
uci set dhcp.lan.ra_slaac='1' || exit 1
uci -q delete dhcp.lan.ra_flags || true
uci add_list dhcp.lan.ra_flags='none' || exit 1
uci set dhcp.lan.dhcpv6='disabled' || exit 1
uci set dhcp.lan.ndp='disabled' || exit 1
uci set dhcp.lan.dns_service='0' || exit 1
uci set dhcp.lan.ra_dns='0' || exit 1
uci commit network || exit 1
uci commit dhcp || exit 1
logger -t ipv6-defaults '已设置 PPPoE IPv6 自动获取和 LAN SLAAC；请检查 WAN 的 IPv6-PD 前缀'
exit 0
